{
  "name": "handymap",
  "version": "1.0.0",
  "private": true,
  "description": "A public world map for short-lived, shared pings.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm run build && npm test && npm run check:links",
    "check:links": "node scripts/check-links.mjs",
    "deploy": "npm run check && wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260908.1",
    "@playwright/test": "^1.63.0",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^22.0.0",
    "@types/topojson-client": "^3.1.5",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
